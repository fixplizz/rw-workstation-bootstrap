PNPM_VERSION=11.15.0

fixplizz_validate_sources() {
  local prefix url sha url_key sha_key
  for prefix in STARSHIP ZOXIDE NERD_FONT MISE UV KUBECTL HELM K9S TOFU SOPS TRIVY GITLEAKS HADOLINT OPENCODE NETBIRD RUSTDESK TERMIX; do
    url_key="${prefix}_URL"
    sha_key="${prefix}_SHA256"
    url="${!url_key}"
    sha="${!sha_key}"
    [[ $url == https://* ]] || return 1
    [[ $url != *latest* ]] || return 1
    [[ $sha =~ ^[0-9a-f]{64}$ ]] || return 1
  done
}
